// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type Balance {
  friend String @db.ObjectId
  due    Float  @default(0)
}

model User {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String   @unique
  password String
  groups   String[] @default([]) // refers to the groups user is in
  Balances String?  @db.ObjectId // refers to the UserBalance
}

model UserBalance {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  owner       String    @db.ObjectId
  settlements Balance[]
  lastUpdated DateTime  @default(now())
}

model GroupBalance {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  group       String    @db.ObjectId
  settlements Balance[]
  lastUpdated DateTime  @default(now())
}

model Group {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  members         String[] @db.ObjectId // refers to users in that group
  groupSettlement String?  @db.ObjectId // refers to the GroupBalance
  expenses        String[] @db.ObjectId // refers to expenses in that group
}

model Expense {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  amount      Int
  paidBy      String    @db.ObjectId // refers to the user who paid this
  participant Balance[] //refers to the participants of that expense
  tag         String?
  timestamp   DateTime  @default(now())
}

model Settlement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Int
  payer     String   @db.ObjectId
  receiver  String   @db.ObjectId
  timestamp DateTime @default(now())
}

model Spliddies {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  author      String      @db.ObjectId
  authorEmail String
  title       String      @unique
  data        spliddyData
}

type spliddyBalance {
  name String
  due  Float
}

type spliddyExpense {
  title   String
  amount  Float
  by      String
  balance spliddyBalance[]
}

type spliddyData {
  members  String[]
  expenses spliddyExpense[]
}
